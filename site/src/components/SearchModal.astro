---
// ⌘K search over the Pagefind index of every page (built after `astro build`).
---
<div class="search-dlg" id="search" data-pagefind-ignore role="dialog" aria-modal="true" aria-label="Search Oxyn" hidden>
  <div class="search-box">
    <div class="search-in">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14zM20 20l-4-4"/></svg>
      <input type="search" placeholder="Search components, states, docs…" aria-label="Search" aria-controls="search-res" autocomplete="off" spellcheck="false" />
      <kbd class="k">esc</kbd>
    </div>
    <div class="search-filters" role="group" aria-label="Filter by type">
      <button type="button" data-type="" aria-pressed="true">All</button>
      <button type="button" data-type="Component" aria-pressed="false">Components</button>
      <button type="button" data-type="Category" aria-pressed="false">Categories</button>
      <button type="button" data-type="Docs" aria-pressed="false">Docs & guides</button>
    </div>
    <div class="search-res" id="search-res" role="listbox" aria-label="Results"></div>
    <div class="search-foot"><span><span class="k">↵</span>open</span><span><span class="k">↑↓</span>move</span><span><span class="k">esc</span>close</span><span style="margin-left:auto">Pagefind</span></div>
  </div>
</div>
