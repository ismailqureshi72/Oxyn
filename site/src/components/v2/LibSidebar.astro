---
// The library's left sidebar: wordmark, search, site links, style, and the collapsible groups.
// The header (wordmark, hide-sidebar toggle, search) sticks to the top of the sidebar's own scroll,
// so it stays in reach anywhere in the long list.
import { icon } from './icons';
import { lockup } from './logo';
import { components, appScreens, agentApps, counts, demoUrl, isPro, motionDemos, composedScreens } from '../../lib/data';
import { FAMILY_NAV, navFamilyOf } from '../../lib/families.mjs';
interface Props { current?: string }
const { current = '' } = Astro.props;
// Components are grouped by family (one idea, many variants); each family is its own collapsible group.
const families = FAMILY_NAV.map((f) => {
  const items = components.filter((d) => navFamilyOf(d)?.slug === f.slug).sort((a, b) => a.name.localeCompare(b.name));
  return { label: f.name, href: items.length ? demoUrl(items[0]) : '/components/', n: items.length, family: true, items: items.map((d) => [d.name, demoUrl(d), isPro(d)] as const) };
});
const nav = [
  ['Library', '/components/', icon.library],
  ['Docs', '/docs/', icon.docs],
  ['Design System', '/docs/theming/', icon.design],
  ['Pricing', '/pricing/', icon.pricing],
];
const libActive = !current.startsWith('/docs') && !current.startsWith('/pricing');
const groupsList = [
  { label: 'Components', href: '/components/', n: counts.components, items: [], head: true },
  ...families,
  { label: 'Screens', href: '/screens/', n: counts.screens - counts.agentApps, items: [...composedScreens.map((c) => [c.name, c.href, false] as const), ...appScreens.map((d) => [d.name, demoUrl(d), isPro(d)] as const)] },
  { label: 'Agent apps', href: '/screens/#agent-apps', n: counts.agentApps, items: agentApps.map((d) => [d.name, demoUrl(d), isPro(d)] as const) },
  { label: 'Blocks', href: '/blocks/', n: 0, items: [] },
  { label: 'Illustrations', href: '/illustrations/', n: 0, items: [] },
  { label: 'Motion', href: '/motion/', n: counts.motion, items: [...motionDemos.map((d) => [d.name, demoUrl(d), isPro(d)] as const), ['Motion tokens', '/motion/', false] as const] },
];
---
<aside class="lsb" id="lsb" aria-label="Library" data-pagefind-ignore>
  <div class="lsb-sticky">
  <div class="lsb-top">
    <a class="wm x-logo-link" href="/" aria-label="Oxyn home"><Fragment set:html={lockup} /></a>
    <button class="iconbtn lsb-hide" type="button" data-sidebar-toggle aria-label="Hide sidebar" title="Hide sidebar"><Fragment set:html={icon.panel} /></button>
    <button class="iconbtn lsb-close" type="button" data-drawer-close aria-label="Close menu"><Fragment set:html={icon.close} /></button>
  </div>
  <button class="lsb-search" type="button" data-open-search aria-label="Search (Command K)"><Fragment set:html={icon.search} /><span>Search…</span><kbd data-mod-k>⌘K</kbd></button>
  </div>
  <nav class="lsb-nav" aria-label="Site">
    {nav.map(([l, h, i]) => (
      <a href={h} aria-current={(l === 'Library' ? libActive : current.startsWith(h)) ? 'page' : undefined}><Fragment set:html={i} />{l}</a>
    ))}
  </nav>
  <div class="lsb-style">
    <span>Style</span>
    <button type="button" class="style-pill" aria-disabled="true" title="One style today; more come with the Studio">Default</button>
  </div>
  <div class="lsb-groups">
    {groupsList.map((g) => g.head ? (
      <p class="lsb-head"><a href={g.href}>{g.label}</a><span class="n">{g.n}</span></p>
    ) : (
      <details class:list={['lsb-g', g.family && 'lsb-fam']} open={g.family ? g.items.some(([, h]) => h === current) : g.items.length > 0 && g.items.length < 400}>
        <summary><a href={g.href}>{g.label}</a>{g.n != null && <span class="n">{g.n}</span>}<span class="chev"><Fragment set:html={icon.chevron} /></span></summary>
        {g.items.length > 0 ? (
          <ul>
            {g.items.map(([name, href, pro]) => (
              <li><a href={href} aria-current={current === href ? 'page' : undefined}><span>{name}</span>{pro && <span class="pro" title="Pro"><Fragment set:html={icon.bolt} /></span>}</a></li>
            ))}
          </ul>
        ) : (
          <p class="lsb-empty">Planned – <a href={g.href}>see what is coming</a></p>
        )}
      </details>
    ))}
  </div>
</aside>
<script is:inline>
  // Keep the sidebar where it was across page loads; bring the current item into view only
  // when it would be off screen.
  (function () {
    var sb = document.getElementById('lsb');
    if (!sb) return;
    var y = sessionStorage.getItem('oxyn-lsb-y');
    if (y !== null) sb.scrollTop = +y;
    var cur = sb.querySelector('.lsb-g li a[aria-current="page"]');
    if (cur) {
      var r = cur.getBoundingClientRect(), s = sb.getBoundingClientRect();
      if (r.top < s.top + 8 || r.bottom > s.bottom - 8) sb.scrollTop += r.top - s.top - s.height / 2;
    }
    var save = function () { sessionStorage.setItem('oxyn-lsb-y', String(sb.scrollTop)); };
    addEventListener('pagehide', save);
    sb.addEventListener('click', save, true);
    // A hairline under the sticky header once the list scrolls beneath it.
    var head = sb.querySelector('.lsb-sticky'), stuck = null;
    var mark = function () { var on = sb.scrollTop > 4; if (on !== stuck) { stuck = on; if (head) head.toggleAttribute('data-stuck', on); } };
    sb.addEventListener('scroll', mark, { passive: true });
    mark();
  })();
</script>
