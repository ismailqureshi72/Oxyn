---
// The sticky top bar of the landing page, pricing and the docs. Three zones: the Oxyn mark on the
// left, the site links centred in a floating pill group, actions on the right. On the white pages it
// condenses into a floating glass bar once the page scrolls (site.js sets data-condensed).
import ThemeRadios from './ThemeRadios.astro';
import GitHubStars from './GitHubStars.astro';
import { icon } from './icons';
import { counts, groups, inGroup } from '../../lib/data';
interface Props { current?: string; inStarlight?: boolean }
const { current = '', inStarlight = false } = Astro.props;
const lib = [
  ['Components', '/components/', `${counts.components}`, 'Agent, chat and everyday parts'],
  ['Screens', '/screens/', `${counts.screens}`, 'Whole app frames'],
  ['Blocks', '/blocks/', 'soon', 'Larger page sections'],
  ['Illustrations', '/illustrations/', 'soon', 'Spot art for empty states'],
  ['Motion', '/motion/', 'tokens', 'Durations, easings and springs'],
];
const on = (p: string) => (current.startsWith(p) ? 'page' : undefined);
---
<div class:list={['tb-in', 'x-nav', { sl: inStarlight }]} data-ovl>
  <a class="wm x-nav-brand" href="/" aria-label="Oxyn home"><span class="x-nav-mark" aria-hidden="true"></span><span>oxyn</span></a>
  <nav class="tb-links x-nav-pill" aria-label="Site">
    <div class="tb-dd">
      <button type="button" class="tb-ddbtn x-nav-a" aria-expanded="false" aria-haspopup="true" aria-controls="tb-lib" data-dd>Library <Fragment set:html={icon.down} /></button>
      <div class="tb-menu" id="tb-lib" role="group" aria-label="Library">
        <div class="tb-menu-col">
          {lib.map(([l, h, n, d]) => (
            <a href={h}><b>{l} <span>{n}</span></b><small>{d}</small></a>
          ))}
        </div>
        <div class="tb-menu-col cats">
          <span class="tb-menu-h">Categories</span>
          {groups.map((g) => <a href={`/components/${g.slug}/`} class="row">{g.name} <span>{inGroup(g.slug).length}</span></a>)}
        </div>
      </div>
    </div>
    <a class="x-nav-a" href="/screens/" aria-current={on('/screens')}>Screens</a>
    <a class="x-nav-a" href="/docs/" aria-current={on('/docs')}>Docs</a>
    <a class="x-nav-a" href="/pricing/" aria-current={on('/pricing')}>Pricing</a>
  </nav>
  <div class="tb-r x-nav-act">
    <button type="button" class="x-nav-search" data-open-search aria-label="Search"><Fragment set:html={icon.search} /><span class="x-nav-k" data-mod-k>⌘K</span></button>
    <ThemeRadios />
    <GitHubStars />
    <a class="x-pill pill-black x-nav-go" href="/components/">Browse library</a>
    <button class="iconbtn tb-menubtn x-nav-menu" type="button" data-menu-toggle aria-expanded="false" aria-controls="mobilemenu" aria-label="Menu"><span class="x-nav-burger" aria-hidden="true"><i></i><i></i></span></button>
  </div>
</div>
<nav class="mobilemenu x-mm" id="mobilemenu" aria-label="Site menu" data-pagefind-ignore>
  <div class="x-mm-grid">
    {lib.map(([l, h, n]) => <a href={h}><span>{l}</span><small>{n}</small></a>)}
  </div>
  <div class="x-mm-list">
    <a href="/docs/">Docs</a>
    <a href="/guides/">Guides</a>
    <a href="/pricing/">Pricing</a>
    <button type="button" class="mm-search" data-open-search>Search…</button>
  </div>
  <div class="x-mm-foot">
    <ThemeRadios />
    <a class="x-pill pill-black" href="/components/">Browse library</a>
  </div>
</nav>
