---
import { REPO } from '../../lib/data';
---
<footer class="x-ft" data-pagefind-ignore>
  <div class="ft-in">
    <div class="ft-brand">
      <a class="wm" href="/">oxyn</a>
      <p>Agent-UI components for Rust – Dioxus on the web, GPUI on the desktop. Open source, MIT.</p>
      <label class="ft-motion"><input type="checkbox" data-reduce-motion /> Reduce motion</label>
    </div>
    <div>
      <h4>Site</h4>
      <ul>
        <li><a href="/components/">Components</a></li>
        <li><a href="/screens/">Screens</a></li>
        <li><a href="/motion/">Motion</a></li>
        <li><a href="/compare/">Compare</a></li>
        <li><a href="/pricing/">Pricing</a></li>
      </ul>
    </div>
    <div>
      <h4>Docs</h4>
      <ul>
        <li><a href="/docs/">Introduction</a></li>
        <li><a href="/docs/installation/">Installation</a></li>
        <li><a href="/docs/theming/">Theming and tokens</a></li>
        <li><a href="/docs/accessibility/">Accessibility</a></li>
        <li><a href="/guides/">Guides</a></li>
      </ul>
    </div>
    <div>
      <h4>Legal &amp; project</h4>
      <ul>
        <li><a href={REPO}>GitHub</a></li>
        <li><a href={`${REPO}/blob/main/LICENSE`}>Licence (MIT)</a></li>
        <li><a href={`${REPO}/blob/main/THIRD_PARTY_NOTICES.md`}>Third-party notices</a></li>
        <li><a href={`${REPO}/blob/main/CONTRIBUTING.md`}>Contributing</a></li>
        <li><a href={`${REPO}/blob/main/SECURITY.md`}>Security</a></li>
      </ul>
    </div>
  </div>
  <div class="ft-base"><span>© 2026 Oxyn</span><span>Made in the open, one plan PR at a time.</span></div>
</footer>
