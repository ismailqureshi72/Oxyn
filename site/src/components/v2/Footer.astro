---
// Site footer: a release-notes / GitHub star call to action, link columns, the agents Oxyn works
// with (brand marks in their own colours), a status line with the theme switch, the MIT note and
// credits, and the Oxyn wordmark set large at the very bottom. Monochrome apart from the marks.
import ThemeRadios from './ThemeRadios.astro';
import { icon } from './icons';
import { lockup, wordmark } from './logo';
import { mark, brands } from './brands';
import { starCount } from './meta';
import { REPO, counts } from '../../lib/data';
const stars = await starCount();
const cols: [string, [string, string][]][] = [
  ['Library', [['Components', '/components/'], ['Screens', '/screens/'], ['Motion', '/motion/'], ['Compare', '/compare/'], ['Pricing', '/pricing/']]],
  ['Docs', [['Introduction', '/docs/'], ['Installation', '/docs/installation/'], ['Theming and tokens', '/docs/theming/'], ['Accessibility', '/docs/accessibility/'], ['Guides', '/guides/']]],
  ['Project', [['GitHub', REPO], ['Licence (MIT)', `${REPO}/blob/main/LICENSE`], ['Third-party notices', `${REPO}/blob/main/THIRD_PARTY_NOTICES.md`], ['Contributing', `${REPO}/blob/main/CONTRIBUTING.md`], ['Security', `${REPO}/blob/main/SECURITY.md`]]],
];
const agents = ['claude-code', 'codex', 'cursor', 'gemini-cli', 'github-copilot', 'zed'];
// The two people who make Oxyn, with their profiles. Marks: GitHub and X from Simple Icons (CC0),
// LinkedIn's "in" bug; all single-colour (currentColor), as the brands allow.
const social = {
  GitHub: '<svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>',
  LinkedIn: '<svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true" focusable="false"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>',
  X: '<svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true" focusable="false"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/></svg>',
};
const founders: [string, [keyof typeof social, string][]][] = [
  ['Ismail Qureshi', [['GitHub', 'https://github.com/ismailqureshi72'], ['LinkedIn', 'https://www.linkedin.com/in/ismail-qureshi72'], ['X', 'https://x.com/IsmailQureshi39']]],
  ['Khubaib Nazeer', [['GitHub', 'https://github.com/Khubaib7-del'], ['LinkedIn', 'https://www.linkedin.com/in/khubaib-nazeer-039b47384/'], ['X', 'https://x.com/KhubaibNazeer_']]],
];
---
<footer class="x-ft x-foot" data-pagefind-ignore>
  <div class="x-foot-in" data-ovl>
    <div class="x-foot-cta">
      <div class="x-foot-pitch">
        <h2 class="x-foot-h">Agent UI that feels finished.</h2>
        <p>New screens and components land one plan PR at a time. Follow the releases or star the repository to keep up.</p>
      </div>
      <div class="x-foot-btns">
        <a class="x-pill pill-black" href={REPO} aria-label={!stars ? 'Star Oxyn on GitHub' : `Star Oxyn on GitHub, ${stars} stars`}><Fragment set:html={icon.star} />Star on GitHub{!!stars && <span class="x-foot-n">{stars.toLocaleString('en-US')}</span>}</a>
        <a class="x-pill pill-grey" href={`${REPO}/releases.atom`}><Fragment set:html={icon.rss} />Release notes feed</a>
      </div>
    </div>
    <div class="x-foot-grid">
      <div class="x-foot-about">
        <a class="wm x-foot-wm" href="/" aria-label="Oxyn home"><Fragment set:html={lockup} /></a>
        <p>Agent-UI components for Rust: Dioxus on the web, GPUI on the desktop. {counts.components} components free, {counts.screens} screens in Pro.</p>
        <span class="x-foot-lbl">Works with</span>
        <ul class="x-foot-agents" aria-label="Agents that can use Oxyn">
          {agents.map((id) => <li title={brands[id].title}><Fragment set:html={mark(id)} /><span class="sr-only">{brands[id].title}</span></li>)}
        </ul>
        <h3 class="x-foot-lbl x-foot-lbl2" id="x-foot-founders">Founders</h3>
        <ul class="x-foot-people" aria-labelledby="x-foot-founders">
          {founders.map(([name, links]) => (
            <li>
              <span class="x-foot-name">{name}</span>
              <span class="x-foot-soc">
                {links.map(([net, url]) => (
                  <a href={url} target="_blank" rel="noopener noreferrer" aria-label={`${name} on ${net}`} title={`${name} on ${net}`}><Fragment set:html={social[net]} /></a>
                ))}
              </span>
            </li>
          ))}
        </ul>
      </div>
      {cols.map(([h, links]) => (
        <nav class="x-foot-col" aria-label={h}>
          <h3 class="x-foot-lbl">{h}</h3>
          <ul>{links.map(([l, u]) => <li><a href={u}>{l}</a></li>)}</ul>
        </nav>
      ))}
    </div>
    <div class="x-foot-bar">
      <span class="x-foot-status"><span class="x-foot-dot" aria-hidden="true"></span>Previews run live: Rust → WebAssembly</span>
      <div class="x-foot-tools">
        <label class="x-foot-motion"><input type="checkbox" data-reduce-motion /> Reduce motion</label>
        <ThemeRadios />
      </div>
    </div>
    <div class="x-foot-legal">
      <span>© 2026 Oxyn · Components MIT licensed, free to use and change.</span>
      <span>Built with Rust, Dioxus, GPUI and Astro. Brand marks belong to their owners.</span>
    </div>
  </div>
  <div class="x-foot-big" aria-hidden="true"><Fragment set:html={wordmark} /></div>
</footer>
