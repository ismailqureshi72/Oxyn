---
// The account control in the site bars. Signed out: a "Sign in" link. Signed in: an avatar button
// with a menu (email, Account, Sign out). Pages stay static: public/account.js asks
// /api/auth/me in the browser, and only when the oxyn_signed_in hint cookie says a session may exist.
import { icon } from './icons';
---
<div class="acct" data-acct data-state="out">
  <a class="acct-in" href="/login/" data-acct-signin><Fragment set:html={icon.user} /><span>Sign in</span></a>
  <button type="button" class="acct-btn" data-acct-btn aria-haspopup="menu" aria-expanded="false" aria-controls="acct-menu" aria-label="Account menu" hidden>
    <span class="acct-av" data-acct-av aria-hidden="true"></span>
  </button>
  <div class="acct-menu" id="acct-menu" role="menu" aria-label="Account" data-acct-menu hidden>
    <div class="acct-who" role="none"><span class="acct-av lg" data-acct-av aria-hidden="true"></span><span class="acct-id" role="none"><b data-acct-name></b><small data-acct-email></small></span></div>
    <a role="menuitem" href="/account/" tabindex="-1"><Fragment set:html={icon.user} />Account</a>
    <button type="button" role="menuitem" data-acct-signout tabindex="-1"><Fragment set:html={icon.signout} />Sign out</button>
  </div>
</div>
<script is:inline src="/account.js" defer></script>
