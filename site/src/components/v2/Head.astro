---
// Everything both layouts put in <head>: meta, the theme boot script and the demo runtime.
import { wasm } from '../../lib/data';
interface Props { title: string; description: string }
const { title, description } = Astro.props;
const path = Astro.url.pathname;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={new URL(path, Astro.site)} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta name="color-scheme" content="light dark" />
<meta property="og:type" content="website" />
<meta property="og:url" content={new URL(path, Astro.site)} />
<meta property="og:image" content={new URL('/og.png', Astro.site)} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={new URL('/og.png', Astro.site)} />
<!-- Logo v2 (E1 cube mark): SVG for modern browsers, PNG and ICO fallbacks, the app icon for iOS. -->
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
<link rel="icon" href="/favicon-16.png" type="image/png" sizes="16x16" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
<script is:inline>
  (function () {
    var d = document.documentElement;
    // Light by default (as the library is designed); a choice made on the site is kept.
    var t = localStorage.getItem('starlight-theme') === 'dark' ? 'dark' : 'light';
    d.dataset.theme = t;
    d.setAttribute('data-oxyn-theme', t);
    if (localStorage.getItem('oxyn-announce') === 'closed') d.dataset.announce = 'hidden';
    if (localStorage.getItem('oxyn-reduce-motion') === '1') d.setAttribute('data-oxyn-reduced', '');
    if (localStorage.getItem('oxyn-sidebar') === 'hidden') d.dataset.sidebar = 'hidden';
    // A member's plan from the last page (public/account.js), only while the sign-in hint cookie
    // is there: Get Pro and the upgrade prompts stay hidden from the first paint.
    var ph = /(?:^|;\s*)oxyn_signed_in=1/.test(document.cookie) ? localStorage.getItem('oxyn-plan-hint') : null;
    if (ph === 'pro' || ph === 'admin') d.dataset.pro = '1';
    if (ph === 'admin') d.dataset.admin = '1';
    // Brand intro: only on the first page of a fresh visit (one per tab session). A reload or any
    // later page skips it and shows the route at once. It never blocks: no pointer events, ~1 s.
    try {
      var calm = localStorage.getItem('oxyn-reduce-motion') === '1' || matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!sessionStorage.getItem('oxyn-intro') && !calm && !/\/full\/?$/.test(location.pathname)) d.setAttribute('data-intro', '');
      sessionStorage.setItem('oxyn-intro', '1');
    } catch (e) {}
  })();
</script>
{wasm.js && <link rel="modulepreload" href={wasm.js} />}
<script is:inline define:vars={{ OXYN_WASM: wasm }}>window.OXYN_WASM = OXYN_WASM;</script>
<script is:inline src="/oxyn-demo.js" type="module"></script>
<script is:inline src="/site.js" defer></script>
