---
// The one sign-in card for everyone (admins too): "Continue with Google", "Continue with GitHub",
// then email + password. Behaviour in public/account.js (POST /api/auth/login or /api/auth/signup,
// then back to where you came from). Each provider button starts disabled ("coming soon") and turns
// on when /api/auth/me reports that provider is set up, so the page never offers a sign-in that
// cannot work.
import { icon } from './icons';
interface Props { mode: 'login' | 'signup' }
const { mode } = Astro.props;
const login = mode === 'login';
---
<section class="auth" data-ovl>
  <div class="auth-card" data-auth={mode}>
    <h1 class="auth-h">{login ? 'Sign in to Oxyn' : 'Create your Oxyn account'}</h1>
    <p class="auth-sub">{login ? 'Welcome back. Pick up where you left off.' : 'Free, optional, and only for you. The library works without it.'}</p>
    <div class="auth-sso">
      <a class="auth-gh auth-gg" href="/api/auth/google/start" rel="nofollow" data-astro-prefetch="false" data-auth-gg aria-disabled="true" aria-describedby="auth-gh-note" tabindex="-1">
        <Fragment set:html={icon.google} /><span>Continue with Google</span>
      </a>
      <a class="auth-gh" href="/api/auth/github/start" rel="nofollow" data-astro-prefetch="false" data-auth-gh aria-disabled="true" aria-describedby="auth-gh-note" tabindex="-1">
        <Fragment set:html={icon.github} /><span>Continue with GitHub</span>
      </a>
    </div>
    <p class="auth-ghnote" id="auth-gh-note" data-auth-ghnote>Google and GitHub sign-in coming soon</p>
    <div class="auth-or" role="separator"><span>or with email</span></div>
    <form class="auth-form" novalidate data-auth-form>
      <label class="fb-field">
        <span class="fb-lbl">Email</span>
        <input type="email" name="email" required maxlength="254" autocomplete={login ? 'username' : 'email'} inputmode="email" placeholder="you@example.com" aria-describedby="auth-err" />
      </label>
      <label class="fb-field">
        <span class="fb-lbl">Password {!login && <i>at least 10 characters</i>}</span>
        <span class="auth-pw">
          <input type="password" name="password" required minlength={login ? undefined : 10} maxlength="256" autocomplete={login ? 'current-password' : 'new-password'} aria-describedby="auth-err" />
          <button type="button" class="auth-eye" data-auth-eye aria-pressed="false" aria-label="Show password">Show</button>
        </span>
      </label>
      <p class="auth-err" id="auth-err" role="alert" data-auth-err hidden></p>
      <button type="submit" class="x-pill pill-black auth-go" data-auth-go>{login ? 'Sign in' : 'Create account'}</button>
    </form>
    <p class="auth-alt">{login ? <>New to Oxyn? <a href="/signup/" data-auth-keep-next>Create an account</a></> : <>Already have an account? <a href="/login/" data-auth-keep-next>Sign in</a></>}</p>
  </div>
  <p class="auth-fine">{login ? 'Forgot your password? Email resets are not available yet; sign in with Google or GitHub on the same email, or send us feedback.' : 'We store a salted hash of your password, never the password itself. No newsletters.'}</p>
</section>
