---
// A library card: category and variants pills, the live mini demo on a grey panel, name,
// one-line description and a copy button (copies the install line).
import OxynDemo from '../OxynDemo.astro';
import { icon } from './icons';
import { demoUrl, groupOf, isScreen, isBlock, blockGroupOf, isPro, installLine, type Demo } from '../../lib/data';
// `lazy`: the preview's markup is fetched when it is first shown (a card in a hidden tab panel).
interface Props { demo: Demo; headingLevel?: 2 | 3; lazy?: boolean }
const { demo, headingLevel = 3, lazy = false } = Astro.props;
const v = demo.variants[0];
const bg = isBlock(demo) ? blockGroupOf(demo) : null;
const g = isScreen(demo) ? { name: 'Screen', slug: '' } : bg ? { name: `Block · ${bg.name}`, slug: '' } : groupOf(demo);
const chipHref = isScreen(demo) ? '/screens/' : bg ? `/blocks/#${bg.slug}` : `/components/${g.slug}/`;
const H = headingLevel === 2 ? 'h2' : 'h3';
const install = installLine(demo);
---
<article class="x-cc">
  <div class="cc-top">
    <a class="x-chip" href={chipHref}>{g.name}</a>
    <span class="x-chip soft">{demo.variants.length} {demo.variants.length === 1 ? 'variant' : 'variants'}</span>
    {isPro(demo) && <span class="x-promark" title="Oxyn Pro: the preview is free, the code needs Pro"><i class="x-bolt" aria-hidden="true"></i><span class="pro-l">Pro</span></span>}
  </div>
  <div class="cc-prev" aria-hidden="true" inert>
    <OxynDemo slug={demo.slug} html={v.html} variant={0} lazy={lazy} />
  </div>
  <div class="cc-foot">
    <div class="cc-txt">
      <H class="cc-name"><a href={demoUrl(demo)}>{demo.name}</a></H>
      <p>{demo.summary}</p>
    </div>
    <button class="cc-copy" type="button" data-copy={install} aria-label={`Copy install command for ${demo.name}`} title="Copy install command"><Fragment set:html={icon.copy} /></button>
  </div>
</article>
