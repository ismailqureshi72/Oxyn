---
// A library card: category and variants pills, the live mini demo on a grey panel, name,
// one-line description and a copy button (copies the install line).
import OxynDemo from '../OxynDemo.astro';
import { icon } from './icons';
import { demoUrl, groupOf, isScreen, isPro, installLine, type Demo } from '../../lib/data';
interface Props { demo: Demo; headingLevel?: 2 | 3 }
const { demo, headingLevel = 3 } = Astro.props;
const v = demo.variants[0];
const g = isScreen(demo) ? { name: 'Screen', slug: '' } : groupOf(demo);
const H = headingLevel === 2 ? 'h2' : 'h3';
const install = installLine(demo);
---
<article class="x-cc">
  <div class="cc-top">
    {g.slug ? <a class="x-chip" href={`/components/${g.slug}/`}>{g.name}</a> : <a class="x-chip" href="/screens/">{g.name}</a>}
    <span class="x-chip soft">{demo.variants.length} {demo.variants.length === 1 ? 'variant' : 'variants'}</span>
    {isPro(demo) && <span class="x-chip pro-chip" title="Oxyn Pro: the preview is free, the code needs Pro"><Fragment set:html={icon.bolt} />Pro</span>}
  </div>
  <div class="cc-prev" aria-hidden="true" inert>
    <OxynDemo slug={demo.slug} html={v.html} variant={0} />
  </div>
  <div class="cc-foot">
    <div class="cc-txt">
      <H class="cc-name"><a href={demoUrl(demo)}>{demo.name}</a></H>
      <p>{demo.summary}</p>
    </div>
    <button class="cc-copy" type="button" data-copy={install} aria-label={`Copy install command for ${demo.name}`} title="Copy install command"><Fragment set:html={icon.copy} /></button>
  </div>
</article>
