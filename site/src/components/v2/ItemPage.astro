---
// One component or screen page, laid out like the reference: breadcrumb, title, lede, install,
// the preview toolbar and panel, then the reference sections in a fixed order.
import Library from '../../layouts/Library.astro';
import OxynDemo from '../OxynDemo.astro';
import ThemeRadios from './ThemeRadios.astro';
import CompCard from './CompCard.astro';
import ProLock from './ProLock.astro';
import BackButton from './BackButton.astro';
import { icon } from './icons';
import { mark } from './brands';
import {
  groupOf, demoUrl, props, specSection, md, highlightRust, cssConst, installLine, CLI_INSTALL, whenToUse, whenNotToUse,
  related, keyChips, notesForAi, guidesFor, isScreen, isBlock, blockGroupOf, isPro, REPO, type Demo,
} from '../../lib/data';

interface Props { demo: Demo }
const { demo } = Astro.props;
const screen = isScreen(demo);
const pro = isPro(demo);
const bg = isBlock(demo) ? blockGroupOf(demo) : null;
const g = screen ? null : bg ? { slug: '', name: `Blocks · ${bg.name}` } : groupOf(demo);
const comps = demo.dioxus.split(',').map((s) => s.trim());
const tables = comps.map((c) => ({ name: c, info: props[c] })).filter((t) => t.info);
const a11ySpec = specSection(demo.spec, 'Accessibility');
const edgeSpec = specSection(demo.spec, 'Responsive', 'Edge cases');
const motionSpec = specSection(demo.spec, 'Micro-interactions');
const timing = specSection(demo.spec, 'Timing');
const usage = `use oxyn_dioxus::{${comps.join(', ')}, ${cssConst(demo.source)}};`;
// Pro items install through the CLI with a Pro licence; copying it without a plan leads to pricing.
const install = installLine(demo);
const cliUsage = `use crate::oxyn::{${comps.join(', ')}, ${cssConst(demo.source)}};`;
const site = 'https://ui.oxyn.workers.dev';
const url = demoUrl(demo);
const prompt = `Add the ${demo.name} component from Oxyn (Rust, Dioxus) to my app. Docs: ${site}${url}`;
const ai = [
  ['Claude', 'claude', `https://claude.ai/new?q=${encodeURIComponent(prompt)}`],
  ['ChatGPT', 'chatgpt', `https://chatgpt.com/?q=${encodeURIComponent(prompt)}`],
  ['Cursor', 'cursor', `https://cursor.com/link/prompt?text=${encodeURIComponent(prompt)}`],
  ['v0', 'v0', `https://v0.app/chat?q=${encodeURIComponent(prompt)}`],
];
const propNames = tables.flatMap((t) => t.info.props.filter((p) => p.required).map((p) => p.name));
const rel = related(demo, 4);
const notRel = whenNotToUse(demo);
const guides = guidesFor(demo);
const sourceUrl = `${REPO}/blob/main/crates/oxyn-dioxus/src/${demo.source}`;
const specUrl = `${REPO}/blob/main/docs/specs/${demo.spec}.md`;
const kind = screen ? 'screen' : bg ? 'block' : 'component';
---
<Library title={`${demo.name} — ${screen ? 'Screens' : g!.name}`} description={demo.summary} type="Component" meta={`category:${screen ? 'Screens' : g!.name}`}>
  <article class="x-art">
    <div class="x-backrow" data-pagefind-ignore>
    <BackButton fallback={screen ? '/screens/' : bg ? '/blocks/' : `/components/${g!.slug}/`} />
    <nav class="x-crumbs" aria-label="Breadcrumb">
      {screen ? (
        <><a href="/screens/">Screens</a><span aria-hidden="true">›</span><span aria-current="page">{demo.name}</span></>
      ) : bg ? (
        <><a href="/blocks/">Blocks</a><span aria-hidden="true">›</span><a href={`/blocks/#${bg.slug}`}>{bg.name}</a><span aria-hidden="true">›</span><span aria-current="page">{demo.name}</span></>
      ) : (
        <><a href="/components/">Components</a><span aria-hidden="true">›</span><a href={`/components/${g!.slug}/`}>{g!.name}</a><span aria-hidden="true">›</span><span aria-current="page">{demo.name}</span></>
      )}
    </nav>
    </div>
    <h1 class="art-title" data-pagefind-meta="title">{demo.name}{pro && <a class="x-chip pro-chip" href={`/pricing/?from=${demo.slug}`} title="Part of Oxyn Pro: the preview is free, the code needs Pro"><i class="x-bolt" aria-hidden="true"></i>Pro</a>}</h1>
    <p class="art-lede">{demo.summary}</p>
    <div class="install-pill copyable"><code>{install}</code><button class="pill-copy" type="button" data-copy={install} data-pro-cli={pro ? 'true' : undefined} aria-label="Copy install command"><Fragment set:html={icon.copy} /></button></div>

    <div class:list={['pvwrap copyable', { 'is-pro': pro }]} id="preview" data-pro-slug={pro ? demo.slug : undefined}>
      <div class="pvbar" data-pagefind-ignore>
        <div class="x-seg" role="tablist" aria-label="Preview or code">
          <button type="button" role="tab" aria-selected="true" data-pv="preview"><Fragment set:html={icon.eye} />Preview</button>
          <button type="button" role="tab" aria-selected="false" data-pv="code"><Fragment set:html={icon.code} />Code</button>
        </div>
        <div class="pvr">
          <div class="x-cstyle" role="radiogroup" aria-label="Component style">
            <button type="button" role="radio" aria-checked="false" data-cstyle="classic" aria-label="Classic style" title="Classic style"><span class="sw sw-classic" aria-hidden="true"></span></button>
            <button type="button" role="radio" aria-checked="true" data-cstyle="clean" aria-label="Clean style" title="Clean style"><span class="sw sw-clean" aria-hidden="true"></span></button>
          </div>
          <ThemeRadios scope="preview" />
          <button class="iconbtn" type="button" data-pv-reset aria-label="Reset the preview" title="Reset"><Fragment set:html={icon.reset} /></button>
          {demo.controls.length > 0 && (
            <button class="iconbtn" type="button" data-pv-controls aria-expanded="false" aria-label="Show controls" title="Controls"><Fragment set:html={icon.sliders} /></button>
          )}
          {screen && <a class="iconbtn" href={`${url}full/`} target="_self" aria-label="Open full screen" title="Open full screen (this tab)"><Fragment set:html={icon.expand} /></a>}
          <span class="pv-div" aria-hidden="true"></span>
          {ai.map(([l, id, h]) => <a class="aibtn x-aibtn-logo" href={h} target="_blank" rel="noopener" title={`Open in ${l}`} aria-label={`Open in ${l}`}><Fragment set:html={mark(id)} /></a>)}
          <a class="aibtn x-aibtn-mcp" href="/docs/installation/" title="MCP server (planned; the oxyn CLI is out)"><Fragment set:html={mark('mcp')} />MCP</a>
          <button class="x-pill pill-black pill-sm x-copy" type="button" data-copy-from="pv"><Fragment set:html={icon.copy} />Copy</button>
          {pro && <a class="x-gopro x-getpro" href={`/pricing/?from=${demo.slug}`}><i class="x-bolt" aria-hidden="true"></i>Get Pro</a>}
        </div>
      </div>
      <div class:list={['pv', { 'pv-screen': screen }]} data-view="preview" data-controls="hidden" data-cstyle="clean">
        <OxynDemo slug={demo.slug} html={demo.html} controls proLock={pro} />
        {pro && <ProLock from={demo.slug} />}
      </div>
      <p class="pv-live" data-live-label data-pagefind-ignore>Rendered from Rust at build time · goes live when visible</p>
    </div>

    <section class="sec" id="when-to-use">
      <h2>When to use</h2>
      <ul class="bul">{whenToUse(demo).map((t) => <li>{t}</li>)}</ul>
    </section>

    <section class="sec" id="when-not-to-use">
      <h2>When not to use</h2>
      {notRel.length ? (
        <ul class="bul">{notRel.map((r) => <li>{r.text}: use <a href={demoUrl(r.demo)}>{r.demo.name}</a> instead.</li>)}</ul>
      ) : (
        <p class="x-muted">The spec names no alternative for this {kind}; see the related {kind}s below.</p>
      )}
    </section>

    <section class="sec" id="installation">
      <h2>Installation</h2>
      {pro ? (
        <>
          <p class="x-muted">{demo.name} is part of <a href="/pricing/">Oxyn Pro</a>; the preview is free. Pro items install with the <a href="/docs/cli/">oxyn CLI</a> once your licence is signed in; until then Pro members copy the code from this page.</p>
          <div class="codeblk copyable"><div class="codeblk-h"><span>Terminal</span><button class="pill-copy" type="button" data-copy={install} data-pro-cli="true" aria-label="Copy"><Fragment set:html={icon.copy} /></button></div><pre><code>{install}</code></pre></div>
        </>
      ) : (
        <>
          <p class="x-muted">{demo.name} is free and MIT. The <a href="/docs/cli/">oxyn CLI</a> copies its code, and the components it needs, into <code>src/oxyn/</code> of your Dioxus or GPUI project, so it is yours to change.</p>
          <div class="codeblk copyable"><div class="codeblk-h"><span>Terminal</span><button class="pill-copy" type="button" data-copy={`${CLI_INSTALL}\noxyn init\n${install}`} aria-label="Copy"><Fragment set:html={icon.copy} /></button></div><pre><code>{CLI_INSTALL}{'\n'}oxyn init{'\n'}{install}</code></pre></div>
          <div class="codeblk copyable"><div class="codeblk-h"><span>Rust</span><button class="pill-copy" type="button" data-copy={cliUsage} aria-label="Copy"><Fragment set:html={icon.copy} /></button></div><pre><code>{cliUsage}</code></pre></div>
          <p class="x-muted">Rather depend on the crate? <code>cargo add oxyn-dioxus oxyn-core --git {REPO}</code>, then <code>{usage}</code></p>
        </>
      )}
    </section>

    <section class="sec" id="usage">
      <h2>Usage</h2>
      {pro ? (
        <div class="codeblk copyable pro-code" data-pro-code="usage"><div class="codeblk-h"><span>Dioxus · rust</span><button class="pill-copy" type="button" data-copy-from="next" aria-label="Copy" hidden><Fragment set:html={icon.copy} /></button></div><pre hidden><code></code></pre><ProLock compact from={demo.slug} /></div>
      ) : (
        <div class="codeblk copyable"><div class="codeblk-h"><span>Dioxus · rust</span><button class="pill-copy" type="button" data-copy-from="next" aria-label="Copy"><Fragment set:html={icon.copy} /></button></div><pre><code set:html={highlightRust(demo.code)} /></pre></div>
      )}
    </section>

    {demo.variants.length > 0 && (
      <section class="sec" id="examples">
        <h2>Examples</h2>
        {demo.variants.map((v, i) => (
          <div class="ex">
            <h3>{v.name.replace(/-/g, ' ').replace(/^./, (c) => c.toUpperCase())}</h3>
            {v.note && <p class="x-muted">{v.note}</p>}
            <div class="ex-prev"><OxynDemo slug={demo.slug} html={v.html} variant={i} /></div>
            {pro ? (
              <details class="ex-code pro-code" data-pro-code={String(i)}><summary>Code <span class="x-chip pro-chip sm"><i class="x-bolt" aria-hidden="true"></i>Pro</span></summary><pre hidden><code></code></pre><ProLock compact from={demo.slug} /></details>
            ) : (
              <details class="ex-code"><summary>Code</summary><pre><code set:html={highlightRust(v.code)} /></pre></details>
            )}
          </div>
        ))}
      </section>
    )}

    <section class="sec" id="api">
      <h2>API reference</h2>
      {tables.map((t) => (
        <>
          <h3 class="mono">{t.name}</h3>
          <div class="ptable-wrap">
            <table class="ptable">
              <thead><tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr></thead>
              <tbody>
                {t.info.props.map((p) => (
                  <tr>
                    <td class="n"><code>{p.name}</code>{p.required && <span class="req">required</span>}</td>
                    <td class="t"><code>{p.type}</code></td>
                    <td class="d">{p.default ? <code>{p.default}</code> : '—'}</td>
                    <td>{p.doc || '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </>
      ))}
      <p class="x-muted small">Read from the Rust signature and doc comments in <a href={sourceUrl}><code>{demo.source}</code></a>.</p>
    </section>

    {demo.keyboard.length > 0 && (
      <section class="sec" id="keyboard">
        <h2>Keyboard interactions</h2>
        <div class="ptable-wrap">
          <table class="ptable kbt">
            <thead><tr><th>Key</th><th>Action</th></tr></thead>
            <tbody>
              {demo.keyboard.map(([k, what]) => (
                <tr><td class="keys">{keyChips(k).map((alt, ai) => (<>{ai > 0 && <span class="or">or</span>}{alt.map((key) => <kbd>{key}</kbd>)}</>))}</td><td>{what}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    <section class="sec" id="accessibility">
      <h2>Accessibility</h2>
      <ul class="bul">{demo.a11y.map((n) => <li>{n}</li>)}</ul>
      {a11ySpec && <details class="fromspec"><summary>From the spec</summary><div class="prose" set:html={md(a11ySpec)} /></details>}
    </section>

    {(motionSpec || timing) && (
      <section class="sec" id="motion">
        <h2>Motion &amp; interaction</h2>
        {motionSpec && <div class="prose" set:html={md(motionSpec)} />}
        {timing && <details class="fromspec"><summary>Timing</summary><div class="prose" set:html={md(timing)} /></details>}
      </section>
    )}

    <section class="sec" id="responsive">
      <h2>Responsive behaviour</h2>
      <ul class="bul">{demo.responsive.map((n) => <li>{n}</li>)}</ul>
      {edgeSpec && <details class="fromspec"><summary>Edge cases (spec)</summary><div class="prose" set:html={md(edgeSpec)} /></details>}
    </section>

    <section class="sec" id="notes-for-ai">
      <h2>Notes for AI</h2>
      <ul class="bul" set:html={notesForAi(demo, propNames).map((n) => `<li>${md(n).replace(/^<p>|<\/p>$/g, '')}</li>`).join('')} />
      <p class="x-muted small">Source: <a href={sourceUrl}>crates/oxyn-dioxus/src/{demo.source}</a> · Spec: <a href={specUrl}>docs/specs/{demo.spec}.md</a></p>
    </section>

    {rel.length > 0 && (
      <section class="sec" id="related">
        <h2>Related</h2>
        <div class="cgrid two">{rel.map((d) => <CompCard demo={d} />)}</div>
      </section>
    )}

    <section class="sec" id="guides">
      <h2>Guides</h2>
      <div class="gcards">
        {guides.map((x) => (
          <a class="gcard" href={x.href}><span class="x-chip soft">{'for' in x ? 'Guide' : 'Docs'}</span><b>{x.title}</b><small>{x.blurb}</small><span class="arr" aria-hidden="true"><Fragment set:html={icon.arrowDownRight} /></span></a>
        ))}
      </div>
    </section>
  </article>
  {pro && <script is:inline src="/pro.js" defer data-pro-name={demo.name}></script>}
</Library>
