---
import Base from '../layouts/Base.astro';
import OxynDemo from '../components/OxynDemo.astro';
import CompCard from '../components/v2/CompCard.astro';
import Laptop from '../components/v2/Laptop.astro';
import Hero from '../components/v2/Hero.astro';
import { icon } from '../components/v2/icons';
import { mark, brands } from '../components/v2/brands';
import { demos, counts, screens, blocks, demoUrl, REPO, CLI_INSTALL } from '../lib/data';
import { homeTabSets, compareTabSlugs } from '../lib/lazy-ssr';
import { BRAND, ENTITY, HOME_DESCRIPTION, organization, website, softwareApplication, faqPage } from '../lib/seo';

const find = (s: string) => demos.find((d) => d.slug === s)!;
const tabSets = homeTabSets;
const compareTabs = compareTabSlugs.map(([k, l, slug]) => [k, l, find(slug)] as const);
// The compare seam: a vertical sine (wavelength 120 px, amplitude 6 px) drawn in a 48 px band whose
// centre (x 24) is the divider. The same sine masks the Oxyn side, and both live in one element that
// flows down by one wavelength per loop, so the drawn line and the cut edge can never drift apart.
const wave = `M24 0 ${Array.from({ length: 16 }, (_, i) => (i === 0 ? 'q12 30 0 60' : 't0 60')).join(' ')}`;
// Glitter: four-point stars of a few sizes along the wave, each twinkling on its own beat.
const sparks: [number, number, number, number][] = [[31, 20, 0, 3.2], [17, 80, 5, 2], [32, 150, 2, 2.6], [16, 205, 7, 3.4], [30, 270, 1, 1.8], [18, 330, 4, 2.8], [33, 395, 6, 2.2], [15, 450, 3, 3], [29, 515, 8, 2.4], [19, 575, 2, 1.8]];
const star = (x: number, y: number, r: number) => `M${x} ${y - r}Q${x} ${y} ${x + r} ${y}Q${x} ${y} ${x} ${y + r}Q${x} ${y} ${x - r} ${y}Q${x} ${y} ${x} ${y - r}Z`;
const agents = ['claude-code', 'codex', 'cursor', 'windsurf', 'github-copilot', 'zed', 'antigravity', 'gemini-cli', 'kimi', 'minimax', 'cline', 'opencode'];
const MCP_INSTALL = `cargo install oxyn-mcp`;
const moreHref: Record<string, [string, string]> = { components: ['/components/', 'Explore all components'], screens: ['/screens/', 'Explore all screens'], blocks: ['/blocks/', 'Explore all blocks'], illustrations: ['/illustrations/', 'About illustrations'], motion: ['/motion/', 'Explore motion'] };
// Brand names in running text get their mark in front (the name stays as text).
const named = (s: string) =>
  s
    .replace(/</g, '&lt;')
    .replace(/\b(Claude|ChatGPT|Cursor|MCP)\b/g, (n) => `<span class="x-bn">${mark(n === 'MCP' ? 'mcp' : n.toLowerCase())}${n}</span>`);
const faq: [string, string, keyof typeof icon][] = [
  ['What is Oxyn UI?', 'Oxyn UI (often called Oxyn) is a library of agent-interface components written in Rust: composer, status, tool calls, plans, approvals, checkpoints and the everyday parts around them. Each one is a Dioxus component for the web, and many also have a GPUI version for the desktop.', 'sparkle'],
  ['Which frameworks does it support?', 'Dioxus (web, and anything Dioxus renders to) and GPUI (desktop). Both read the same models and state machines from oxyn-core, so a component behaves the same in each.', 'layers'],
  ['Is it free?', `The core is. ${counts.free} components (the most complete ones), the docs and the CLI are free and MIT licensed. Pro adds the other ${counts.proComponents} components and every screen, agent-app template, block and kit for $19.99 a month (the first 100 new subscribers pay $12.99 for their first month); the previews stay free to open.`, 'pricing'],
  ['Are the previews real?', 'Yes. Every preview is the Rust component itself: rendered to HTML when the site is built, then mounted live from one WebAssembly bundle when it scrolls into view.', 'eye'],
  ['How do I install a component?', `Install the oxyn CLI with ${CLI_INSTALL}, run oxyn init in your Dioxus or GPUI project, then oxyn add and a component's name: its source lands in src/oxyn/, yours to change.`, 'terminal'],
  ['Can my coding agent use it?', 'Yes. Connect the oxyn-mcp server to Claude Code, Codex, Cursor or any MCP client and it searches the library and adds components for you. Every page also has Notes for AI and Open in Claude, ChatGPT and Cursor links.', 'plug'],
  ['What is Studio?', 'A visual editor for Oxyn components: change tokens, states and variants on a live preview, then copy or install the result. It is coming soon.', 'design'],
  ['What about light, dark and accessibility?', 'Every component ships light, dark and high-contrast themes from one token set, follows the WAI-ARIA patterns for its role, and respects reduced motion.', 'design'],
];
// The sections a search engine can show as sitelinks, each with its link-preview card as a real image.
const explore: [string, string, string, string][] = [
  ['Components', '/components/', 'components', `${counts.components} Rust UI components for AI agents, ${counts.free} of them free.`],
  ['Screens', '/screens/', 'screens', `${counts.screens} whole agent app screens built from the components.`],
  ['Blocks', '/blocks/', 'blocks', `${counts.blocks} agent and AI surfaces, ready to drop in.`],
  ['Docs', '/docs/', 'docs', 'Install, theme and ship Oxyn UI in a Dioxus or GPUI app.'],
  ['CLI', '/docs/cli/', 'cli', `${CLI_INSTALL}, then oxyn add a component.`],
  ['MCP server', '/docs/mcp/', 'mcp', 'Let Claude Code, Codex or Cursor add components for you.'],
  ['Pricing', '/pricing/', 'pricing', 'Free components under MIT; Pro for every screen and block.'],
  ['About', '/about/', 'about', `What ${BRAND} is, who makes it and how it works.`],
];
const jsonld = [organization(), website(), softwareApplication(), faqPage(faq.map(([q, a]) => [q, a] as [string, string]))];
---
<Base title={`${BRAND} — Rust UI components for AI agents`} description={HOME_DESCRIPTION} type="Page" promo jsonld={jsonld}>
  <Hero />

  <section class="lp-sec x-what" aria-labelledby="h-what">
    <h2 id="h-what">What is {BRAND}?</h2>
    <p class="lp-sub x-what-p">{ENTITY}</p>
    <ul class="x-explore" aria-label={`Explore ${BRAND}`}>
      {explore.map(([l, href, img, d]) => (
        <li><a href={href}><img src={`/og/t/${img}.webp`} width="640" height="336" loading="lazy" decoding="async" alt={`${l}: ${BRAND}, Rust UI components for AI agents`} /><b>{l}</b><span>{d}</span></a></li>
      ))}
    </ul>
  </section>

  <section class="lp-sec" aria-labelledby="h-agents">
    <h2 id="h-agents">Agents first,<br />the rest of your app too</h2>
    <div class="lp-tabs" data-tabs>
      <div class="utabs" role="tablist" aria-label="Library sections">
        {tabSets.map(([k, l], i) => <button type="button" role="tab" id={`t-${k}`} aria-controls={`p-${k}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{l}</button>)}
      </div>
      {tabSets.map(([k, l, slugs], i) => (
        <div class="lp-panel" role="tabpanel" id={`p-${k}`} aria-labelledby={`t-${k}`} hidden={i !== 0}>
          {slugs ? (
            <div class="cgrid">{slugs.map((s) => <CompCard demo={find(s)} lazy={i !== 0} />)}</div>
          ) : (
            <div class="lp-soon"><b>{l} are coming soon.</b><span>Animated spot art for empty states, onboarding and errors, drawn from the same tokens.</span><a class="x-pill pill-grey" href={`/${k}/`}>Learn more</a></div>
          )}
          <div class="lp-more"><a class="x-pill pill-grey" href={moreHref[k][0]}>{moreHref[k][1]}</a></div>
        </div>
      ))}
    </div>
  </section>

  <section class="lp-sec x-lap-sec" aria-labelledby="h-screens">
    <h2 id="h-screens">Complete screens,<br />not just parts</h2>
    <p class="lp-sub x-muted">Whole app frames on a 1440 × 900 stage. Pick one and it opens on the laptop.</p>
    <Laptop />
  </section>

  <section class="lp-sec" aria-labelledby="h-built">
    <h2 id="h-built">Built for agents,<br />not just for copy and paste</h2>
    <p class="lp-sub">Set it up once, then ask for a screen or a component and your agent pulls it into your app.</p>
    <div class="x-mcp">
      <div class="mcp-l" aria-label="Example agent session">
        <div class="mcp-ask">Add an approval step before the agent sends email</div>
        <ul class="mcp-steps">
          <li><span class="ok"><Fragment set:html={icon.check} /></span><code>search_components</code><span class="x-muted">"approval"</span></li>
          <li><span class="ok"><Fragment set:html={icon.check} /></span><code>get_component</code><span class="x-muted">approval-card</span></li>
          <li><span class="ok"><Fragment set:html={icon.check} /></span><code>add_component</code><span class="x-muted">approval-card</span></li>
        </ul>
        <p class="mcp-done">Added <code>src/oxyn/approval_card.rs</code> and wired it to the send step.</p>
      </div>
      <div class="mcp-r">
        <span class="mcp-lbl">Install the MCP server</span>
        <div class="codeblk copyable"><div class="codeblk-h"><span>Terminal</span><button class="pill-copy" type="button" data-copy={MCP_INSTALL} aria-label="Copy"><Fragment set:html={icon.copy} /></button></div><pre><code>{MCP_INSTALL}</code></pre></div>
        <span class="mcp-lbl">Works with your agent</span>
        <ul class="x-agents" aria-label="Agents that can use Oxyn">
          {agents.map((id) => <li title={brands[id].title}><Fragment set:html={mark(id)} /><span>{brands[id].title}</span></li>)}
        </ul>
        <p class="x-muted" set:html={named('Then add it to your agent with one command or a few lines of config. Every component page also ends with Notes for AI, and its toolbar opens it in Claude, ChatGPT or Cursor.')}></p>
        <a class="x-pill pill-grey" href="/docs/mcp/">Set up your agent</a>
      </div>
    </div>
  </section>

  <section class="lp-sec" aria-labelledby="h-file">
    <h2 id="h-file">One file per piece,<br />code you own</h2>
    <div class="trio">
      <div class="trio-c">
        <div class="trio-p term" aria-hidden="true"><pre><span class="x-muted">$</span> oxyn add approval-card{'\n'}<span class="x-muted">✓ src/oxyn/approval_card.rs</span>{'\n'}<span class="x-muted">✓ use crate::oxyn::ApprovalCard</span></pre></div>
        <h3>One command, one file</h3>
        <p><code>oxyn add</code> copies a component's source, and what it needs, into <code>src/oxyn/</code> in your project.</p>
      </div>
      <div class="trio-c">
        <div class="trio-p" aria-hidden="true" inert><OxynDemo slug="segmented-control" html={find('segmented-control').variants[0].html} variant={0} /></div>
        <h3>Yours to change</h3>
        <p>Plain Rust and CSS variables: rename it, restyle it, or change its states. Nothing hides behind a package.</p>
      </div>
      <div class="trio-c">
        <div class="trio-p dark" data-theme="dark" data-oxyn-theme="dark" aria-hidden="true" inert><OxynDemo slug="thinking-pill" html={find('thinking-pill').variants[0].html} variant={0} /></div>
        <h3>Light and dark, built in</h3>
        <p>Every component reads the same tokens: light, dark and high contrast, with reduced motion respected.</p>
      </div>
    </div>
    <div class="lp-more"><a class="x-pill pill-grey" href="/docs/">Learn more</a></div>
  </section>

  <section class="lp-sec" aria-labelledby="h-studio">
    <h2 id="h-studio">Studio,<br />edit it visually <span class="x-chip x-soon-chip x-studio-chip">Soon</span></h2>
    <p class="lp-sub x-muted">Pick a component, change its tokens, states and variants on a live preview, then copy the code or install it with the CLI.</p>
    <div class="x-studio-tease" aria-hidden="true">
      <div class="xs-pane xs-l"><b>Layers</b><i></i><i></i><i class="on"></i><i></i></div>
      <div class="xs-stage"><div class="xs-card"><span class="xs-t"></span><span class="xs-s"></span><span class="xs-b"></span></div></div>
      <div class="xs-pane xs-r"><b>Tokens</b><span><em>radius</em><u>12</u></span><span><em>accent</em><u class="xs-sw"></u></span><span><em>density</em><u>Cozy</u></span></div>
    </div>
    <div class="lp-more"><a class="x-pill pill-grey" href="/studio/">About Studio</a></div>
  </section>

  <section class="lp-sec" aria-labelledby="h-same">
    <h2 id="h-same">Same screen,<br />with the details done</h2>
    <div class="lp-tabs" data-tabs>
      <div class="utabs" role="tablist" aria-label="Compare">
        {compareTabs.map(([k, l], i) => <button type="button" role="tab" id={`tc-${k}`} aria-controls={`pc-${k}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{l}</button>)}
      </div>
      {compareTabs.map(([k, l, d], i) => (
        <div class="lp-panel" role="tabpanel" id={`pc-${k}`} aria-labelledby={`tc-${k}`} hidden={i !== 0}>
          <div class="browser">
            <div class="browser-bar" aria-hidden="true"><i></i><i></i><i></i><span>app.example.com/{k}</span></div>
            <div class="x-cmp" style="--pos:50%" data-cmp>
              <div class="cmp-before" aria-hidden="true">
                {k === 'approval' && (
                  <div class="vibe"><p>The agent wants to run: <b>send_email</b></p><p>to: list-all@example.com</p><p>Approve?</p><div><button tabindex="-1">Yes</button> <button tabindex="-1">No</button></div></div>
                )}
                {k === 'tools' && (
                  <div class="vibe"><p>Running tool...</p><p>search_files({'{'}"query":"invoice"{'}'})</p><p>done</p><p>Running tool...</p><p>read_file</p></div>
                )}
                {k === 'chat' && (
                  <div class="vibe"><p><b>You:</b> why did the build fail?</p><p><b>AI:</b> Thinking...</p><p>Thinking...</p><p>The build failed because of a missing dependency in the lockfile. Run install again.</p></div>
                )}
              </div>
              <div class="cmp-clip" aria-hidden="true">
                <div class="cmp-ride">
                  <div class="cmp-mbox"><div class="cmp-anti"><div class="cmp-after" inert><OxynDemo slug={d.slug} html={d.variants[0].html} variant={0} defer lazy={i !== 0} /></div></div></div>
                  <svg class="cmp-wave" focusable="false"><path class="cmp-halo" d={wave} /><path class="cmp-stroke" d={wave} /><path class="cmp-glint" d={wave} />{sparks.map(([x, y, i, r]) => <path class="cmp-spark" d={star(x, y, r)} style={`--i:${i}`} />)}</svg>
                </div>
              </div>
              <span class="cmp-tag l">Vibecoded</span>
              <span class="cmp-tag r"><span aria-hidden="true">✦</span> With Oxyn</span>
              <div class="cmp-line" aria-hidden="true"><span class="cmp-handle"><svg viewBox="0 0 20 20" width="16" height="16" focusable="false"><path d="M7 5 2 10l5 5M13 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></span></div>
              <input class="cmp-range" type="range" min="0" max="100" value="50" aria-label={`Drag to compare: plain ${l.toLowerCase()} against Oxyn's ${d.name}`} />
            </div>
          </div>
          <p class="lp-cap">← Drag to compare →</p>
        </div>
      ))}
    </div>
  </section>

  <section class="lp-sec x-ask" aria-labelledby="h-faq">
    <h2 id="h-faq">Questions, answered</h2>
    <p class="lp-sub x-muted">Pick a question.</p>
    <div class="x-ask-box" data-tabs data-ovl>
      <div class="x-ask-pills" role="tablist" aria-label="Questions">
        {faq.map(([q, , ic], i) => (
          <button type="button" role="tab" class="x-ask-pill" id={`tq-${i}`} aria-controls={`pq-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}><span class="x-ask-i"><Fragment set:html={icon[ic]} /></span><span class="x-ask-q">{q}</span></button>
        ))}
      </div>
      {faq.map(([q, a], i) => (
        <div class="x-ask-a" role="tabpanel" id={`pq-${i}`} aria-labelledby={`tq-${i}`} hidden={i !== 0}>
          <h3>{q}</h3>
          <p set:html={named(a)}></p>
        </div>
      ))}
    </div>
    <div class="x-ask-cta">
      <a class="x-pill pill-black" href="/docs/">Read the docs</a>
      <a class="x-pill pill-grey" href={`${REPO}/issues`}><Fragment set:html={icon.github} />Ask on GitHub</a>
    </div>
  </section>
</Base>
