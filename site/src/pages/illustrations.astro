---
import Planned from '../components/Planned.astro';
---
<Planned title="Illustrations" section="Illustrations" lede="Animated spot illustrations for empty states, onboarding and errors in agent apps, drawn from the same tokens so they follow the theme."
  groups={[
    ['Empty states', 'Nothing here yet, no runs, no results.'],
    ['Agent at work', 'Thinking, searching, building, waiting for you.'],
    ['Outcomes', 'Done, failed, offline, rate limited.'],
    ['Onboarding', 'Connect a model, add a key, first run.'],
  ]} />
