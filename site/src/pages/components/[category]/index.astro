---
import Library from '../../../layouts/Library.astro';
import LibTabs from '../../../components/v2/LibTabs.astro';
import CompCard from '../../../components/v2/CompCard.astro';
import Redirect from '../../../components/v2/Redirect.astro';
import { groups, inGroup, categories, type Group } from '../../../lib/data';
import { redirects } from '../../../lib/taxonomy.mjs';

export function getStaticPaths() {
  const real = groups.map((g) => ({ params: { category: g.slug }, props: { group: g, to: null } }));
  const moved = (redirects([], categories) as [string, string][]).map(([from, to]) => ({
    params: { category: from.split('/')[2] },
    props: { group: null, to },
  }));
  return [...real, ...moved];
}
const { group, to } = Astro.props as { group: Group | null; to: string | null };
const list = group ? inGroup(group.slug) : [];
---
{to ? <Redirect to={to} /> : (
  <Library title={`${group!.name} components`} description={group!.blurb} type="Category" current="/components/">
    <div class="lidx">
      <nav class="x-crumbs" aria-label="Breadcrumb"><a href="/components/">Components</a><span aria-hidden="true">›</span><span aria-current="page">{group!.name}</span></nav>
      <h1 class="lidx-title">{group!.name}</h1>
      <p class="lede">{group!.blurb} {list.length} components.</p>
      <LibTabs active="components" />
      <div class="cgrid">{list.map((d) => <CompCard demo={d} />)}</div>
    </div>
  </Library>
)}
