---
import Library from '../../layouts/Library.astro';
import LibTabs from '../../components/v2/LibTabs.astro';
import CompCard from '../../components/v2/CompCard.astro';
import { components, groups, inGroup } from '../../lib/data';
const ordered = groups.flatMap((g) => inGroup(g.slug));
---
<Library title="Components" description={`${components.length} agent-UI components for Rust – Dioxus and GPUI, rendered live.`} type="Category">
  <div class="lidx">
    <h1 class="lidx-title">Agent-ready UI for Rust apps – every component rendered live from its own source.</h1>
    <LibTabs active="components" />
    <div class="cgrid">{ordered.map((d) => <CompCard demo={d} />)}</div>
  </div>
</Library>
