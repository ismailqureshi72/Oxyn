---
// Blocks: larger compositions built from the components, grouped by what they are for. All Pro:
// previews stay free to open; the code needs Pro.
import Library from '../../layouts/Library.astro';
import LibTabs from '../../components/v2/LibTabs.astro';
import CompCard from '../../components/v2/CompCard.astro';
import { icon } from '../../components/v2/icons';
import { blocks, blockGroups } from '../../lib/data';
---
<Library title="Blocks" description={`${blocks.length} whole agent and AI surfaces, built from the components.`} type="Category" current="/blocks/">
  <div class="lidx">
    <h1 class="lidx-title">Blocks – whole agent and AI surfaces, built from the components.</h1>
    <p class="lede pro-lede"><span class="x-chip pro-chip"><Fragment set:html={icon.bolt} />Pro</span> Blocks are part of <a href="/pricing/">Oxyn Pro</a>. Every preview here is free to open and try; Pro opens their code.</p>
    <LibTabs active="blocks" />
    {blockGroups.filter((g) => g.items.length).map((g) => (
      <>
        <h2 class="x-sec-h" id={g.slug}>{g.name} – {g.blurb}</h2>
        <div class="cgrid">{g.items.map((d) => <CompCard demo={d} />)}</div>
      </>
    ))}
  </div>
</Library>
