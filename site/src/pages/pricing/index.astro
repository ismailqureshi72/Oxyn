---
// Pricing: Free, Pro and Team, monthly or yearly, sold through Polar (docs/pricing.md). The page is
// static; public/pricing.js switches the interval, asks /api/billing/plans how many founder spots are
// left (and hides the founder rate once 100 are taken), and marks the plan you are on. Every buy
// button goes to /api/billing/checkout, which signs you in first and then opens Polar's checkout.
import Base from '../../layouts/Base.astro';
import { icon } from '../../components/v2/icons';
import { counts, PRICES } from '../../lib/data';

const usd = (n: number) => `$${Number.isInteger(n) ? n : n.toFixed(2)}`;
const perMonth = (y: number) => usd(Math.round((y / 12) * 100) / 100);
const save = Math.round((1 - PRICES.pro.year / (PRICES.pro.month * 12)) * 100);
const co = (key: string) => `/api/billing/checkout?plan=${key}`;

const freeList = [
  `The ${counts.free} free components, with all their variants and code`,
  'Dioxus on the web, GPUI on the desktop',
  'Light, dark and high-contrast themes',
  'Specs, live previews and docs',
  'The oxyn CLI: oxyn add for every free component',
];
const proList = [
  'Everything in Free',
  `All ${counts.screens} screens, with their code`,
  `Agent-app templates (${counts.agentApps} today)`,
  `All ${counts.proComponents} Pro components, including the AI components, with their code`,
  'Blocks and category kits as they ship',
  'Weekly drops of new Pro items',
  'Studio extras: saved themes and presets',
  'Pro CLI and MCP access',
];
const teamList = [
  'Everything in Pro',
  `Up to ${PRICES.team.people} people: you plus ${PRICES.team.seats} teammates`,
  'Invite teammates by email; the owner manages seats and billing',
  'One invoice for the team',
];
const rows: [string, string, string, string][] = [
  [`The ${counts.free} free components (code)`, 'yes', 'yes', 'yes'],
  [`The other ${counts.proComponents} components (code)`, 'no', 'yes', 'yes'],
  ['Docs, specs and live previews', 'yes', 'yes', 'yes'],
  ['Screens and agent-app templates (code)', 'no', 'yes', 'yes'],
  ['Blocks and kits', 'no', 'yes', 'yes'],
  ['Weekly drops', 'no', 'yes', 'yes'],
  ['Studio extras', 'no', 'yes', 'yes'],
  ['Pro CLI and MCP', 'no', 'yes', 'yes'],
  ['Developers', '1', '1', `Up to ${PRICES.team.people}`],
];
const faq: [string, string][] = [
  ['What happens if I cancel?', 'The code you already installed keeps working, for good. Cancelling stops new Pro access at the end of the period you paid for: the Pro code on this site, the Pro registry and the Pro CLI. You can cancel any time from Manage billing.'],
  ['Who handles the payment?', 'Checkout is secure and run by Polar, our merchant of record. Polar takes the payment, handles the receipts and invoices, and Oxyn never sees your card.'],
  ['Are taxes included?', 'Prices are in US dollars before tax. Sales tax or VAT for your country is added at checkout, so you see the full amount before you pay.'],
  ['How does the founder rate work?', `The first ${PRICES.founder.cap} subscribers pay ${usd(PRICES.founder.month)} a month or ${usd(PRICES.founder.year)} a year, for the same Pro. The rate stays as long as the subscription stays active. If it ends, a new subscription is at the regular price.`],
  ['What does Team include?', `Pro for a team of up to ${PRICES.team.people} people: the owner plus ${PRICES.team.seats} teammates. The owner adds teammates by email on the Account page; each teammate signs in to Oxyn with Google or GitHub on that email, and Pro opens for them.`],
  ['Can I switch between monthly and yearly?', 'Yes. Open Manage billing from your account menu and change the plan there; Polar works out the difference.'],
  ['Do I need an account?', 'Free needs nothing. To subscribe you sign in first, so Pro is tied to your Oxyn account.'],
];
---
<Base back="/" title="Pricing" description={`${counts.free} Oxyn components are free. Pro opens every other component, screen, template, block and kit: ${usd(PRICES.pro.month)} a month or ${usd(PRICES.pro.year)} a year.`}>
  <div class="wrap content pricing" data-pricing data-interval="month" data-founder="open">
    <header class="pr-head">
      <h1 class="x-title">Free for the core. Pro for whole apps.</h1>
      <p class="lede">Every free component and primitive is MIT licensed. Pro adds the screens, agent-app templates, the AI components, blocks and kits on top, with new drops every week.</p>
    </header>

    <p class="pr-note" role="status" data-pr-note hidden></p>

    <div class="pr-founder" data-pr-founder>
      <span class="pr-founder-i" aria-hidden="true"><Fragment set:html={icon.sparkle} /></span>
      <p><b>Founder rate.</b> The first {PRICES.founder.cap} subscribers get Pro for {usd(PRICES.founder.month)} a month or {usd(PRICES.founder.year)} a year, locked in while the subscription stays active. <span class="pr-left" data-pr-left></span></p>
    </div>

    <div class="pr-toggle">
      <div class="x-seg" role="radiogroup" aria-label="Billing period">
        <button type="button" role="radio" aria-checked="true" data-pr-int="month">Monthly</button>
        <button type="button" role="radio" aria-checked="false" data-pr-int="year">Yearly <span class="pr-save">save {save}%</span></button>
      </div>
    </div>

    <div class="tiers pr-tiers">
      <section class="tier pr-tier" aria-labelledby="t-free" data-tier="free">
        <div class="pr-top"><h2 id="t-free">Free</h2><span class="x-chip soft pr-cur" data-pr-cur hidden>Your plan</span></div>
        <p class="pr-for">For anyone building agent UI in Rust.</p>
        <div class="price"><span class="pr-amt">$0</span><small>forever</small></div>
        <p class="pr-sub">MIT licensed</p>
        <ul class="pr-list">{freeList.map((t) => <li><Fragment set:html={icon.check} />{t}</li>)}</ul>
        <a class="x-pill pill-grey pr-go" href="/components/">Browse components</a>
      </section>

      <section class="tier main pr-tier" aria-labelledby="t-pro" data-tier="pro">
        <div class="pr-top"><h2 id="t-pro">Pro</h2><span class="x-chip pro-chip pr-fd-chip fd"><i class="x-bolt" aria-hidden="true"></i>Founder rate</span><span class="x-chip soft pr-cur" data-pr-cur hidden>Your plan</span></div>
        <p class="pr-for">For one developer shipping whole apps.</p>
        <div class="price">
          <span class="pr-amt mo"><span class="fd">{usd(PRICES.founder.month)}</span><span class="rg">{usd(PRICES.pro.month)}</span></span>
          <span class="pr-amt yr"><span class="fd">{usd(PRICES.founder.year)}</span><span class="rg">{usd(PRICES.pro.year)}</span></span>
          <small class="mo">/ month</small><small class="yr">/ year</small>
        </div>
        <p class="pr-sub">
          <span class="mo"><span class="fd"><s>{usd(PRICES.pro.month)}</s> regular price</span><span class="rg">Billed monthly</span></span>
          <span class="yr"><span class="fd"><s>{usd(PRICES.pro.year)}</s> regular · {perMonth(PRICES.founder.year)} a month</span><span class="rg">{perMonth(PRICES.pro.year)} a month, billed yearly</span></span>
        </p>
        <ul class="pr-list">{proList.map((t) => <li><Fragment set:html={icon.check} />{t}</li>)}</ul>
        <a class="x-pill pill-black pr-go" href={co('pro-founder-month')} rel="nofollow" data-astro-prefetch="false"
          data-pr-buy data-k-month="pro-month" data-k-year="pro-year" data-kf-month="pro-founder-month" data-kf-year="pro-founder-year"><Fragment set:html={icon.bolt} /><span data-pr-label>Get Pro</span></a>
      </section>

      <section class="tier pr-tier" aria-labelledby="t-team" data-tier="team">
        <div class="pr-top"><h2 id="t-team">Team</h2><span class="x-chip soft">Up to {PRICES.team.people} people</span><span class="x-chip soft pr-cur" data-pr-cur hidden>Your plan</span></div>
        <p class="pr-for">For a small team on one plan.</p>
        <div class="price">
          <span class="pr-amt mo">{usd(PRICES.team.month)}</span><span class="pr-amt yr">{usd(PRICES.team.year)}</span>
          <small class="mo">/ month</small><small class="yr">/ year</small>
        </div>
        <p class="pr-sub"><span class="mo">Billed monthly</span><span class="yr">{perMonth(PRICES.team.year)} a month, billed yearly</span></p>
        <ul class="pr-list">{teamList.map((t) => <li><Fragment set:html={icon.check} />{t}</li>)}</ul>
        <a class="x-pill pill-grey pr-go" href={co('team-month')} rel="nofollow" data-astro-prefetch="false"
          data-pr-buy data-k-month="team-month" data-k-year="team-year"><span data-pr-label>Get Team</span></a>
      </section>
    </div>
    <p class="pr-fine">Prices in US dollars. Taxes are added at checkout. Secure checkout by <a href="https://polar.sh" rel="noopener">Polar</a>, merchant of record.</p>

    <section class="block pr-cmp" aria-labelledby="h-cmp">
      <h2 id="h-cmp">Compare plans</h2>
      <div class="ptable-wrap">
        <table class="ptable pr-table">
          <thead><tr><th scope="col"><span class="sr-only">Feature</span></th><th scope="col">Free</th><th scope="col">Pro</th><th scope="col">Team</th></tr></thead>
          <tbody>
            {rows.map(([f, a, b, c]) => (
              <tr><th scope="row">{f}</th>{[a, b, c].map((v) => <td>{v === 'yes' ? <span class="pr-y" aria-label="Included"><Fragment set:html={icon.check} /></span> : v === 'no' ? <span class="pr-n" aria-label="Not included">–</span> : v}</td>)}</tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="block pr-faq" aria-labelledby="h-prfaq">
      <h2 id="h-prfaq">Questions</h2>
      <div class="faq">
        {faq.map(([q, a]) => (
          <details><summary>{q}<span class="chev" aria-hidden="true"><Fragment set:html={icon.down} /></span></summary><p>{a}</p></details>
        ))}
      </div>
    </section>
  </div>
  <script is:inline src="/pricing.js" defer></script>
</Base>
