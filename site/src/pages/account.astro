---
// Your account: email, how you sign in, when it was created, your plan (and Team seats), and sign
// out here or everywhere.
// Static like every page; public/account.js fills it from /api/auth/me.
import Base from '../layouts/Base.astro';
import { icon } from '../components/v2/icons';
---
<Base back="/" title="Account" description="Your Oxyn account." index={false}>
  <section class="auth acct-page" data-ovl>
    <div class="auth-card wide" data-account data-state="loading" aria-busy="true">
      <div class="acct-load" data-account-loading role="status">Loading your account…</div>
      <div data-account-out hidden>
        <h1 class="auth-h">Account</h1>
        <p class="auth-sub">You are not signed in.</p>
        <div class="acct-actions"><a class="x-pill pill-black" href="/login/?next=/account/">Sign in</a><a class="x-pill pill-grey" href="/signup/?next=/account/">Create an account</a></div>
      </div>
      <div data-account-in hidden>
        <div class="acct-top">
          <span class="acct-av xl" data-acct-av aria-hidden="true"></span>
          <div class="acct-top-t"><h1 class="auth-h" data-account-name>Account</h1><p class="auth-sub" data-account-email></p></div>
        </div>
        <dl class="acct-dl">
          <div><dt>Email</dt><dd data-account-email2></dd></div>
          <div><dt>Sign-in methods</dt><dd data-account-providers></dd></div>
          <div><dt>Member since</dt><dd data-account-created></dd></div>
        </dl>
        <section class="acct-plan" id="plan" aria-labelledby="h-plan" data-plan>
          <div class="acct-plan-h"><h2 id="h-plan">Plan</h2><span class="x-chip" data-plan-chip>Free</span></div>
          <p class="acct-plan-line" data-plan-line>Every component and primitive, free and MIT licensed.</p>
          <p class="auth-err acct-plan-note" role="status" data-plan-note hidden></p>
          <div class="acct-actions">
            <a class="x-pill pill-black" href="/pricing/" data-plan-upgrade><Fragment set:html={icon.bolt} />See Pro plans</a>
            <a class="x-pill pill-grey" href="/api/billing/portal" rel="nofollow" data-astro-prefetch="false" data-plan-manage hidden><Fragment set:html={icon.card} />Manage billing</a>
          </div>
          <div class="acct-seats" data-seats hidden>
            <h3>Team seats <span class="acct-seats-n" data-seat-count></span></h3>
            <p class="acct-plan-line">A Team is up to 4 people: you plus 3 teammates. Add a teammate's email. They sign in to Oxyn with Google or GitHub on that email, and Pro opens for them.</p>
            <ul class="acct-seat-list" data-seat-list></ul>
            <form class="acct-seat-form" novalidate data-seat-form>
              <label class="fb-field"><span class="fb-lbl">Teammate email</span><input type="email" name="email" required maxlength="254" autocomplete="off" inputmode="email" placeholder="teammate@example.com" aria-describedby="seat-err" /></label>
              <button type="submit" class="x-pill pill-black">Add seat</button>
            </form>
            <p class="auth-err" id="seat-err" role="alert" data-seat-err hidden></p>
          </div>
        </section>
        <p class="auth-err" role="alert" data-account-err hidden></p>
        <div class="acct-actions">
          <button type="button" class="x-pill pill-black" data-acct-signout><Fragment set:html={icon.signout} />Sign out</button>
          <button type="button" class="x-pill pill-grey" data-account-all>Sign out of all sessions</button>
        </div>
        <p class="auth-fine in">Signing out of all sessions ends every browser where this account is signed in, including this one.</p>
      </div>
    </div>
  </section>
</Base>
