---
// Full-bleed white pages (landing, pricing, 404): promo strip, sticky top bar, footer.
import '../generated/oxyn-tokens.css';
import '../generated/oxyn-components.css';
import '../styles/chrome.css';
import '../styles/site.css';
import '../styles/polish.css';
import '../styles/demo.css';
import Head from '../components/v2/Head.astro';
import TopBar from '../components/v2/TopBar.astro';
import Footer from '../components/v2/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import Feedback from '../components/Feedback.astro';
import BackButton from '../components/v2/BackButton.astro';
import { ANNOUNCE } from '../lib/data';

interface Props {
  title: string;
  description: string;
  /** Pagefind result type: Component, Category, Page. */
  type?: string;
  promo?: boolean;
  /** false: kept out of search engines and the site search (sign-in and account pages). */
  index?: boolean;
  /** Shows a Back button above the content; the value is where it goes without a same-site history entry. */
  back?: string;
}
const { title, description, type = 'Page', promo = false, index = true, back } = Astro.props;
const path = Astro.url.pathname;
const fullTitle = path === '/' ? title : `${title} · Oxyn`;
// Promo strip: from the data (src/lib/data.ts ANNOUNCE), so it never claims a tier it doesn't have.
const promo_ = ANNOUNCE;
---
<!doctype html>
<html lang="en" data-theme="light" data-oxyn-theme="light">
  <head><Head title={fullTitle} description={description} />{!index && <meta name="robots" content="noindex" />}</head>
  <body class="site page-white">
    <a class="x-skip" href="#main">Skip to content</a>
    {promo && (
      <div class="announce" role="region" aria-label="Announcement" data-pagefind-ignore>
        <a href={promo_.href}><span aria-hidden="true">✦</span> <span class="an-long">{promo_.text}</span><span class="an-short">{promo_.short}</span> →</a>
        <button type="button" data-close-announce aria-label="Dismiss announcement">✕</button>
      </div>
    )}
    <header class="x-tb" data-pagefind-ignore><TopBar current={path} /></header>
    {index ? (
      <main id="main" data-pagefind-body data-pagefind-filter={`type:${type}`} data-pagefind-meta={`type:${type}`}>{back && <div class="x-backbar"><BackButton fallback={back} /></div>}<slot /></main>
    ) : (
      <main id="main" data-pagefind-ignore="all">{back && <div class="x-backbar"><BackButton fallback={back} /></div>}<slot /></main>
    )}
    <Footer />
    <SearchModal />
    <Feedback />
  </body>
</html>
