// Cloudflare Workers static-assets config for the Oxyn site.
// Build first (`npm run build` in site/), then `npx wrangler deploy` from site/.
// CI deploys on every push to main (repo secrets CLOUDFLARE_API_TOKEN / CLOUDFLARE_ACCOUNT_ID).
// Live at https://ui.oxyn.workers.dev (Worker name "ui").
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ui",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
