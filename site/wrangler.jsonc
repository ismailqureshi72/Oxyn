// Cloudflare Workers static-assets config for the Oxyn site.
// Build first (`npm run build` in site/), then `npx wrangler deploy` from site/.
// Not deployed yet: needs CLOUDFLARE_API_TOKEN / CLOUDFLARE_ACCOUNT_ID.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oxyn-site",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
